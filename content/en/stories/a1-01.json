  "title": "Breakfast in Chicago",
  "title_de": "Frühstück in Chicago",
  "topics": ["essen", "alltag"],
  "summary_de": "Lena aus Berlin frühstückt in einem kleinen Café in Chicago und plaudert mit dem Kellner Mike.",
  "sentences": [
    { "text": "It's Saturday morning in Chicago.", "de": "Es ist Samstagmorgen in Chicago." },
    { "text": "Lena is from Germany, but she lives in Chicago now.", "de": "Lena kommt aus Deutschland, aber sie wohnt jetzt in Chicago." },
    { "text": "She is at a small café on her street.", "de": "Sie ist in einem kleinen Café in ihrer Straße." },
    { "text": "The café is old, but it's very nice.", "de": "Das Café ist alt, aber sehr schön." },
    { "text": "The waiter is very friendly.", "de": "Der Kellner ist sehr freundlich.", "break": true },
    { "text": "His name is Mike.", "de": "Er heißt Mike." },
    { "text": "\"Good morning! How are you?\" Mike asks.", "de": "„Guten Morgen! Wie geht's?“, fragt Mike." },
    { "text": "\"I'm good, thanks,\" Lena says. \"A coffee and pancakes, please.\"", "de": "„Gut, danke“, sagt Lena. „Einen Kaffee und Pancakes, bitte.“" },
    { "text": "\"Do you want milk in your coffee?\"", "de": "„Möchten Sie Milch in den Kaffee?“" },
    { "text": "\"Yes, a little milk, please.\"", "de": "„Ja, ein bisschen Milch, bitte.“" },
    { "text": "The pancakes are big and very good.", "de": "Die Pancakes sind groß und sehr lecker.", "break": true },
    { "text": "The coffee is hot.", "de": "Der Kaffee ist heiß." },
    { "text": "Mike asks, \"Where are you from?\"", "de": "Mike fragt: „Woher kommen Sie?“" },
    { "text": "\"I'm from Berlin, in Germany,\" Lena says.", "de": "„Ich komme aus Berlin, in Deutschland“, sagt Lena." },
    { "text": "\"Wow! Your English is very good!\"", "de": "„Wow! Ihr Englisch ist sehr gut!“" },
    { "text": "Lena is happy.", "de": "Lena freut sich." },
    { "text": "Breakfast is twelve dollars.", "de": "Das Frühstück kostet zwölf Dollar.", "break": true },
    { "text": "\"Thank you, Mike. See you next Saturday!\"", "de": "„Danke, Mike. Bis nächsten Samstag!“" },
    { "text": "\"Bye, Lena! Have a nice day!\"", "de": "„Tschüss, Lena! Einen schönen Tag noch!“" }
  ],
