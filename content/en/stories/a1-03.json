  "title": "My Family",
  "title_de": "Meine Familie",
  "topics": ["alltag"],
  "summary_de": "Die sechzehnjährige Emily aus Denver stellt ihre Eltern, ihre Geschwister, ihre Oma und ihre zwei Haustiere vor.",
  "sentences": [
    { "text": "Hi! My name is Emily.", "de": "Hallo! Ich heiße Emily." },
    { "text": "I'm sixteen years old, and I live in Denver with my family.", "de": "Ich bin sechzehn Jahre alt und wohne mit meiner Familie in Denver." },
    { "text": "My mom is a nurse. Her name is Karen.", "de": "Meine Mutter ist Krankenpflegerin. Sie heißt Karen.", "break": true },
    { "text": "My dad is a teacher. His name is Mark.", "de": "Mein Vater ist Lehrer. Er heißt Mark." },
    { "text": "They are very nice, and they work a lot.", "de": "Sie sind sehr nett und arbeiten viel." },
    { "text": "I have a brother and a sister.", "de": "Ich habe einen Bruder und eine Schwester.", "break": true },
    { "text": "My brother, Jake, is twelve.", "de": "Mein Bruder Jake ist zwölf." },
    { "text": "He loves soccer and video games.", "de": "Er liebt Fußball und Videospiele." },
    { "text": "My sister, Lily, is only five.", "de": "Meine Schwester Lily ist erst fünf." },
    { "text": "She's very cute, but she's loud, too!", "de": "Sie ist sehr süß, aber auch laut!" },
    { "text": "We have two pets: a dog and a cat.", "de": "Wir haben zwei Haustiere: einen Hund und eine Katze.", "break": true },
    { "text": "The dog is big and brown. His name is Max.", "de": "Der Hund ist groß und braun. Er heißt Max." },
    { "text": "The cat is small and black. Her name is Luna.", "de": "Die Katze ist klein und schwarz. Sie heißt Luna." },
    { "text": "Max is three years old, and Luna is one.", "de": "Max ist drei Jahre alt und Luna ist eins." },
    { "text": "Max loves the park, and Luna loves my bed!", "de": "Max liebt den Park, und Luna liebt mein Bett!" },
    { "text": "My grandma lives with us, too.", "de": "Meine Oma wohnt auch bei uns.", "break": true },
    { "text": "She's seventy-two years old.", "de": "Sie ist zweiundsiebzig Jahre alt." },
    { "text": "Every Sunday, she cooks dinner, and we eat together.", "de": "Jeden Sonntag kocht sie das Abendessen, und wir essen zusammen." },
    { "text": "I love my family!", "de": "Ich liebe meine Familie!" }
  ],
