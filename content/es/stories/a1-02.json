  "title": "En la estación de tren",
  "title_de": "Am Bahnhof",
  "topics": ["reisen"],
  "summary_de": "Jonas aus Hamburg kauft am Bahnhof in Madrid eine Fahrkarte nach Toledo und fragt nach Preis, Uhrzeit und Gleis.",
  "sentences": [
    { "speaker": "Jonas", "text": "Buenos días.", "de": "Guten Morgen." },
    { "speaker": "Empleada", "text": "Buenos días. ¿Qué tal?", "de": "Guten Morgen. Wie geht's?" },
    { "speaker": "Jonas", "text": "Bien, gracias. Un billete para Toledo, por favor.", "de": "Gut, danke. Eine Fahrkarte nach Toledo, bitte." },
    { "speaker": "Empleada", "text": "¿Para hoy?", "de": "Für heute?" },
    { "speaker": "Jonas", "text": "Sí, para hoy.", "de": "Ja, für heute." },
    { "speaker": "Empleada", "text": "¿De ida o de ida y vuelta?", "de": "Einfach oder hin und zurück?" },
    { "speaker": "Jonas", "text": "De ida y vuelta, por favor.", "de": "Hin und zurück, bitte." },
    { "speaker": "Empleada", "text": "Hay un tren a las diez y otro a las once.", "de": "Es gibt einen Zug um zehn und einen um elf." },
    { "speaker": "Jonas", "text": "A las diez, por favor. ¿Y a qué hora llega a Toledo?", "de": "Um zehn, bitte. Und um wie viel Uhr kommt er in Toledo an?" },
    { "speaker": "Empleada", "text": "Llega a las diez y media.", "de": "Er kommt um halb elf an." },
    { "speaker": "Jonas", "text": "Muy bien. ¿Cuánto cuesta?", "de": "Sehr gut. Wie viel kostet das?" },
    { "speaker": "Empleada", "text": "Son dieciocho euros.", "de": "Das macht achtzehn Euro." },
    { "speaker": "Jonas", "text": "¿Puedo pagar con tarjeta?", "de": "Kann ich mit Karte zahlen?" },
    { "speaker": "Empleada", "text": "Sí, claro.", "de": "Ja, natürlich." },
    { "speaker": "Jonas", "text": "¿De qué andén sale el tren?", "de": "Von welchem Gleis fährt der Zug ab?" },
    { "speaker": "Empleada", "text": "Del andén cinco.", "de": "Von Gleis fünf." },
    { "speaker": "Jonas", "text": "¿Y dónde está el andén cinco?", "de": "Und wo ist Gleis fünf?" },
    { "speaker": "Empleada", "text": "Allí, a la derecha.", "de": "Dort, rechts." },
    { "speaker": "Jonas", "text": "Muchas gracias.", "de": "Vielen Dank." },
    { "speaker": "Empleada", "text": "De nada. ¿Es usted alemán?", "de": "Gern geschehen. Sind Sie Deutscher?" },
    { "speaker": "Jonas", "text": "Sí, soy de Hamburgo, pero vivo en Madrid.", "de": "Ja, ich komme aus Hamburg, aber ich wohne in Madrid." },
    { "speaker": "Empleada", "text": "¡Habla muy bien español!", "de": "Sie sprechen sehr gut Spanisch!" },
    { "speaker": "Jonas", "text": "Gracias. Hablo un poco.", "de": "Danke. Ich spreche ein bisschen." },
    { "speaker": "Empleada", "text": "Aquí tiene su billete. ¡Buen viaje!", "de": "Hier ist Ihre Fahrkarte. Gute Reise!" },
    { "speaker": "Jonas", "text": "Gracias. ¡Adiós!", "de": "Danke. Auf Wiedersehen!" }
  ],
