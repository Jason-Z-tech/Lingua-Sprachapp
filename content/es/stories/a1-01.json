  "title": "Un café en Madrid",
  "title_de": "Ein Café in Madrid",
  "topics": ["essen", "alltag"],
  "summary_de": "Ana aus Berlin bestellt in einem kleinen Café in Madrid und lernt den Kellner Luis kennen.",
  "sentences": [
    { "text": "Es lunes por la mañana.", "de": "Es ist Montagmorgen." },
    { "text": "Ana está en un café pequeño de Madrid.", "de": "Ana ist in einem kleinen Café in Madrid." },
    { "text": "Ana es de Alemania, pero vive en España.", "de": "Ana kommt aus Deutschland, aber sie lebt in Spanien." },
    { "text": "Habla un poco de español.", "de": "Sie spricht ein bisschen Spanisch." },
    { "text": "El camarero se llama Luis.", "de": "Der Kellner heißt Luis.", "break": true },
    { "text": "Luis es muy simpático.", "de": "Luis ist sehr nett." },
    { "text": "«Buenos días. ¿Qué tal?», dice Luis.", "de": "„Guten Morgen. Wie geht's?“, sagt Luis." },
    { "text": "«Muy bien, gracias. Un café con leche, por favor», dice Ana.", "de": "„Sehr gut, danke. Einen Milchkaffee, bitte“, sagt Ana." },
    { "text": "Luis pregunta: «¿De dónde eres?»", "de": "Luis fragt: „Woher kommst du?“", "break": true },
    { "text": "«Soy alemana, de Berlín», responde Ana.", "de": "„Ich bin Deutsche, aus Berlin“, antwortet Ana." },
    { "text": "«¡Hablas muy bien español!», dice Luis.", "de": "„Du sprichst sehr gut Spanisch!“, sagt Luis." },
    { "text": "Ana está contenta.", "de": "Ana freut sich." },
    { "text": "El café cuesta dos euros.", "de": "Der Kaffee kostet zwei Euro.", "break": true },
    { "text": "«Gracias, Luis. ¡Hasta mañana!»", "de": "„Danke, Luis. Bis morgen!“" },
    { "text": "«¡Adiós, Ana!»", "de": "„Tschüss, Ana!“" }
  ],
