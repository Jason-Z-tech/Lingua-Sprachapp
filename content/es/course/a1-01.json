    { "type": "translate", "de": "Sehr gut, danke.", "answers": ["Muy bien, gracias."] },
    { "type": "translate", "de": "Wir sind Freunde.", "answers": ["Somos amigos.", "Nosotros somos amigos.", "Somos amigas.", "Nosotras somos amigas."] },
    { "type": "order", "de": "Bis morgen, Carlos!", "answer": "¡Hasta mañana, Carlos!" },
    { "type": "order", "de": "Sind Sie Herr García?", "answer": "¿Es usted el señor García?" },
    { "type": "listen", "text": "Buenas tardes, ¿qué tal?", "de": "Guten Tag, wie geht's?" },
    { "type": "listen", "text": "Me llamo Ana y ella es Marta.", "de": "Ich heiße Ana und sie ist Marta." }
  ]
