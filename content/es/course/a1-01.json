        { "type": "cloze", "text": "Él se ___ Marcos.", "answers": ["llama"], "de": "Er heißt Marcos.", "hint": "llamarse" },
        { "type": "cloze", "text": "¿Cómo ___ llama usted?", "answers": ["se"], "de": "Wie heißen Sie?" },
