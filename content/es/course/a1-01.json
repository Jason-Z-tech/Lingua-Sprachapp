      ]
    }
  ],
  "dialogue": {
    "title": "El primer día",
    "title_de": "Der erste Tag",
    "lines": [
      { "speaker": "Lucía", "text": "¡Hola! Buenos días.", "de": "Hallo! Guten Morgen." },
      { "speaker": "Diego", "text": "Buenos días. ¿Cómo te llamas?", "de": "Guten Morgen. Wie heißt du?" },
      { "speaker": "Lucía", "text": "Me llamo Lucía. ¿Y tú?", "de": "Ich heiße Lucía. Und du?" },
      { "speaker": "Diego", "text": "Yo me llamo Diego. Mucho gusto.", "de": "Ich heiße Diego. Freut mich." },
      { "speaker": "Lucía", "text": "Encantada. ¿Qué tal?", "de": "Sehr erfreut. Wie geht's?" },
      { "speaker": "Diego", "text": "Muy bien, gracias. ¿Y tú?", "de": "Sehr gut, danke. Und dir?" },
      { "speaker": "Lucía", "text": "Bien, gracias. Mira, ella es Marta. Es mi amiga.", "de": "Gut, danke. Schau, das ist Marta. Sie ist meine Freundin." },
      { "speaker": "Marta", "text": "Hola, Diego. Encantada.", "de": "Hallo, Diego. Sehr erfreut." },
      { "speaker": "Diego", "text": "Encantado, Marta. Bueno, hasta luego.", "de": "Sehr erfreut, Marta. Also, bis später." },
      { "speaker": "Marta", "text": "¡Adiós, Diego! ¡Hasta mañana!", "de": "Tschüss, Diego! Bis morgen!" }
    ]
  },
  "exercises": [
    { "type": "match", "pairs": [["hola", "hallo"], ["adiós", "tschüss"], ["gracias", "danke"], ["por favor", "bitte"], ["de nada", "gern geschehen"]] },
