  "grammar": [
    {
      "id": "ser",
      "title": "Das Verb ser (sein)",
      "blocks": [
        { "type": "p", "text": "Ser bedeutet „sein“. Wie im Deutschen ist das Verb unregelmäßig – die Formen lernst du am besten auswendig." },
        { "type": "table", "head": ["Person", "ser", "Deutsch"], "rows": [
          ["yo", "soy", "ich bin"],
          ["tú", "eres", "du bist"],
          ["él / ella / usted", "es", "er / sie ist; Sie sind"],
          ["nosotros / nosotras", "somos", "wir sind"],
          ["vosotros / vosotras", "sois", "ihr seid"],
          ["ellos / ellas / ustedes", "son", "sie sind; Sie sind (mehrere)"]
        ] },
        { "type": "tip", "text": "Die Personalpronomen lässt man meistens weg, weil die Verbform schon zeigt, wer gemeint ist: Soy Ana. = Ich bin Ana." },
        { "type": "tip", "text": "Usted (Sie) ist die höfliche Anrede. Das Verb steht dann in der 3. Person: ¿Es usted el señor García?" },
        { "type": "examples", "items": [
          { "text": "Soy Lucía.", "de": "Ich bin Lucía." },
          { "text": "¿Eres Pablo?", "de": "Bist du Pablo?" },
          { "text": "Somos amigos.", "de": "Wir sind Freunde." },
          { "text": "Ellos son Ana y Pedro.", "de": "Das sind Ana und Pedro." }
        ] }
      ],
      "exercises": [
        { "type": "cloze", "text": "Yo ___ Marta.", "answers": ["soy"], "de": "Ich bin Marta.", "hint": "ser" },
        { "type": "cloze", "text": "¿Tú ___ Pedro?", "answers": ["eres"], "de": "Bist du Pedro?", "hint": "ser" },
        { "type": "cloze", "text": "Ella ___ mi amiga.", "answers": ["es"], "de": "Sie ist meine Freundin.", "hint": "ser" },
        { "type": "cloze", "text": "Nosotros ___ amigos.", "answers": ["somos"], "de": "Wir sind Freunde.", "hint": "ser" },
        { "type": "cloze", "text": "¿Vosotros ___ Ana y Luis?", "answers": ["sois"], "de": "Seid ihr Ana und Luis?", "hint": "ser" },
        { "type": "cloze", "text": "Ellos ___ Carmen y Javier.", "answers": ["son"], "de": "Das sind Carmen und Javier.", "hint": "ser" },
        { "type": "choice", "prompt": "Wie fragst du Herrn García höflich, ob er es ist?",
          "options": ["¿Eres tú el señor García?", "¿Es usted el señor García?", "¿Son ustedes el señor García?"],
          "answer": 1, "explain": "Bei usted steht das Verb in der 3. Person Einzahl: es." }
      ]
    },
    {
      "id": "llamarse",
      "title": "Wie heißt du? – llamarse",
      "blocks": [
        { "type": "p", "text": "Um zu sagen, wie man heißt, benutzt man llamarse. Wörtlich bedeutet das „sich nennen“: Me llamo Ana. = Ich nenne mich Ana." },
        { "type": "table", "head": ["Person", "llamarse", "Deutsch"], "rows": [
          ["yo", "me llamo", "ich heiße"],
          ["tú", "te llamas", "du heißt"],
          ["él / ella / usted", "se llama", "er / sie heißt; Sie heißen"]
        ] },
        { "type": "p", "text": "Fragen beginnen im Spanischen mit einem umgedrehten Fragezeichen, Ausrufe mit einem umgedrehten Ausrufezeichen: ¿Cómo te llamas? ¡Hola!" },
        { "type": "examples", "items": [
          { "text": "¿Cómo te llamas?", "de": "Wie heißt du?" },
          { "text": "¿Cómo se llama usted?", "de": "Wie heißen Sie?" },
          { "text": "Me llamo Diego.", "de": "Ich heiße Diego." },
          { "text": "Ella se llama Sofía.", "de": "Sie heißt Sofía." }
        ] }
      ],
      "exercises": [
        { "type": "cloze", "text": "Me ___ Daniel.", "answers": ["llamo"], "de": "Ich heiße Daniel.", "hint": "llamarse" },
