  "title": "Colazione al bar",
  "title_de": "Frühstück in der Bar",
  "topics": ["essen", "alltag"],
  "summary_de": "Lena aus München frühstückt wie jeden Morgen in einer kleinen Bar in Bologna: Cappuccino und Cornetto an der Theke.",
  "sentences": [
    { "text": "È martedì mattina.", "de": "Es ist Dienstagmorgen." },
    { "text": "Lena è a Bologna.", "de": "Lena ist in Bologna." },
    { "text": "Lena è tedesca, di Monaco, ma abita in Italia.", "de": "Lena ist Deutsche, aus München, aber sie wohnt in Italien." },
    { "text": "Ogni mattina fa colazione al bar.", "de": "Jeden Morgen frühstückt sie in der Bar." },
    { "text": "Il bar è piccolo, ma è molto bello.", "de": "Die Bar ist klein, aber sehr schön." },
    { "text": "Il barista si chiama Paolo.", "de": "Der Barista heißt Paolo.", "break": true },
    { "text": "Paolo è molto simpatico.", "de": "Paolo ist sehr nett." },
    { "text": "«Buongiorno, Lena! Come stai?», dice Paolo.", "de": "„Guten Morgen, Lena! Wie geht's dir?“, sagt Paolo." },
    { "text": "«Bene, grazie! Un cappuccino e un cornetto, per favore.»", "de": "„Gut, danke! Einen Cappuccino und ein Cornetto, bitte.“" },
    { "text": "«Un cornetto con la crema o con la marmellata?»", "de": "„Ein Cornetto mit Vanillecreme oder mit Marmelade?“" },
    { "text": "«Con la crema, grazie.»", "de": "„Mit Creme, danke.“" },
    { "text": "Lena mangia il cornetto al banco, come gli italiani.", "de": "Lena isst das Cornetto im Stehen an der Theke, wie die Italiener.", "break": true },
    { "text": "Il cappuccino è caldo e buono.", "de": "Der Cappuccino ist heiß und gut." },
    { "text": "Al bar c'è anche Marco, un amico di Lena.", "de": "In der Bar ist auch Marco, ein Freund von Lena." },
    { "text": "Marco prende un caffè.", "de": "Marco nimmt einen Espresso." },
    { "text": "«Ciao, Lena! Anche tu qui?»", "de": "„Hallo, Lena! Du auch hier?“" },
    { "text": "«Sì! Qui il cappuccino è molto buono.»", "de": "„Ja! Hier ist der Cappuccino sehr gut.“" },
    { "text": "Lena paga alla cassa.", "de": "Lena bezahlt an der Kasse.", "break": true },
    { "text": "Il cappuccino e il cornetto costano tre euro.", "de": "Der Cappuccino und das Cornetto kosten drei Euro." },
    { "text": "«Grazie, Paolo! A domani!»", "de": "„Danke, Paolo! Bis morgen!“" },
    { "text": "«Ciao, Lena! Buona giornata!»", "de": "„Tschüss, Lena! Einen schönen Tag!“" }
  ],
