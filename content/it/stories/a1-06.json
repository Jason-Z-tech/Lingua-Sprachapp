  "level": "A1",
  "type": "dialog",
  "title": "Che musica ascolti?",
  "title_de": "Was für Musik hörst du?",
  "topics": ["musik"],
  "summary_de": "Giulia und Marco erzählen sich, welche Musik sie mögen und welches Instrument sie spielen, und Giulia kommt zu Marcos Konzert.",
  "sentences": [
    { "speaker": "Giulia", "text": "Ciao, Marco! Che cosa ascolti?", "de": "Hallo, Marco! Was hörst du da?" },
    { "speaker": "Marco", "text": "Ascolto i Måneskin. Ti piace il rock?", "de": "Ich höre Måneskin. Magst du Rock?" },
    { "speaker": "Giulia", "text": "Sì, un po'. Ma preferisco il pop.", "de": "Ja, ein bisschen. Aber ich mag lieber Pop." },
    { "speaker": "Marco", "text": "Davvero? E chi ascolti?", "de": "Wirklich? Und wen hörst du?" },
    { "speaker": "Giulia", "text": "Ascolto Laura Pausini ed Elodie. Mi piacciono molto!", "de": "Ich höre Laura Pausini und Elodie. Ich mag sie sehr!" },
    { "speaker": "Marco", "text": "Elodie? Non la conosco.", "de": "Elodie? Die kenne ich nicht.",
      "gloss": { "la": { "lemma": "la", "de": "sie (Pronomen: non la conosco = ich kenne sie nicht)", "pos": "pron" } } },
    { "speaker": "Giulia", "text": "È molto brava. Canta e balla benissimo.", "de": "Sie ist sehr gut. Sie singt und tanzt super." },
    { "speaker": "Marco", "text": "E tu suoni uno strumento?", "de": "Und spielst du ein Instrument?" },
    { "speaker": "Giulia", "text": "Sì, suono il pianoforte. E tu?", "de": "Ja, ich spiele Klavier. Und du?" },
    { "speaker": "Marco", "text": "Io suono la chitarra in un gruppo.", "de": "Ich spiele Gitarre in einer Band." },
    { "speaker": "Giulia", "text": "In un gruppo? Che bello! Che musica suonate?", "de": "In einer Band? Wie toll! Was für Musik spielt ihr?" },
    { "speaker": "Marco", "text": "Rock, naturalmente! Venerdì sera abbiamo un concerto.", "de": "Rock natürlich! Am Freitagabend haben wir ein Konzert." },
    { "speaker": "Giulia", "text": "Davvero? Dove?", "de": "Wirklich? Wo?" },
    { "speaker": "Marco", "text": "Al Bar Luna, in centro. Vieni?", "de": "In der Bar Luna, im Zentrum. Kommst du?" },
    { "speaker": "Giulia", "text": "Sì, certo! A che ora?", "de": "Ja, klar! Um wie viel Uhr?" },
    { "speaker": "Marco", "text": "Alle nove.", "de": "Um neun." },
    { "speaker": "Giulia", "text": "Perfetto. Ma dopo il concerto ascoltiamo un po' di pop, va bene?", "de": "Perfekt. Aber nach dem Konzert hören wir ein bisschen Pop, okay?" },
    { "speaker": "Marco", "text": "Va bene, va bene!", "de": "Na gut, na gut!" }
  ],
