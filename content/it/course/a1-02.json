  "dialogue": {
    "title": "In un bar a Bologna",
    "title_de": "In einem Café in Bologna",
    "lines": [
      { "speaker": "Sara", "text": "Ciao! Sono Sara. Tu come ti chiami?", "de": "Hallo! Ich bin Sara. Wie heißt du?" },
      { "speaker": "Lena", "text": "Ciao, Sara! Mi chiamo Lena. Piacere!", "de": "Hallo, Sara! Ich heiße Lena. Freut mich!" },
      { "speaker": "Sara", "text": "Piacere! Di dove sei, Lena?", "de": "Freut mich! Woher kommst du, Lena?" },
      { "speaker": "Lena", "text": "Sono tedesca, di Monaco. E tu?", "de": "Ich bin Deutsche, aus München. Und du?" },
      { "speaker": "Sara", "text": "Io sono italiana, di Napoli, e abito qui a Bologna.", "de": "Ich bin Italienerin, aus Neapel, und ich wohne hier in Bologna." },
