  "grammar": [
    {
      "id": "nazionalita",
      "title": "Nationalitäten: tedesco, tedesca, francese",
      "blocks": [
        { "type": "p", "text": "Woher du kommst, kannst du auch mit deiner Nationalität sagen: Sono tedesco. = Ich bin Deutscher. Nationalitäten sind im Italienischen Adjektive und werden kleingeschrieben – genau wie Sprachen." },
        { "type": "p", "text": "Adjektive auf -o haben eine weibliche Form auf -a. Adjektive auf -e sind für Männer und Frauen gleich." },
        { "type": "table", "head": ["männlich", "weiblich", "Deutsch"], "rows": [
          ["tedesco", "tedesca", "deutsch"],
          ["italiano", "italiana", "italienisch"],
          ["austriaco", "austriaca", "österreichisch"],
          ["svizzero", "svizzera", "schweizerisch"],
          ["spagnolo", "spagnola", "spanisch"],
          ["francese", "francese", "französisch"],
          ["inglese", "inglese", "englisch"]
        ] },
        { "type": "tip", "text": "Die Sprache ist die männliche Form: Parlo tedesco. = Ich spreche Deutsch. Mit Artikel: il tedesco, l'italiano – Imparo l'italiano." },
        { "type": "tip", "text": "Mehrere Personen: -o wird zu -i, -a zu -e und -e zu -i: italiani, italiane, francesi. Bei tedesco bleibt der k-Laut, deshalb mit h: tedeschi, tedesche." },
        { "type": "examples", "items": [
          { "text": "Klaus è tedesco e Petra è tedesca.", "de": "Klaus ist Deutscher und Petra ist Deutsche." },
          { "text": "Sei italiana?", "de": "Bist du Italienerin?" },
          { "text": "Pierre è francese e anche Julie è francese.", "de": "Pierre ist Franzose und Julie ist auch Französin." },
          { "text": "Siamo austriaci.", "de": "Wir sind Österreicher." }
        ] }
      ],
      "exercises": [
        { "type": "cloze", "text": "Petra è ___.", "answers": ["tedesca"], "de": "Petra ist Deutsche.", "hint": "tedesco" },
        { "type": "cloze", "text": "Marco è ___.", "answers": ["italiano"], "de": "Marco ist Italiener.", "hint": "italiano" },
        { "type": "cloze", "text": "Julie è ___.", "answers": ["francese"], "de": "Julie ist Französin.", "hint": "francese" },
        { "type": "cloze", "text": "Anna è di Vienna. È ___.", "answers": ["austriaca"], "de": "Anna ist aus Wien. Sie ist Österreicherin.", "hint": "austriaco" },
        { "type": "cloze", "text": "Lukas e Nina sono ___.", "answers": ["svizzeri"], "de": "Lukas und Nina sind Schweizer.", "hint": "svizzero" },
        { "type": "translate", "de": "Ich bin Deutsche.", "answers": ["Sono tedesca.", "Io sono tedesca."] },
        { "type": "translate", "de": "Bist du Spanier?", "answers": ["Sei spagnolo?", "Tu sei spagnolo?", "Sei spagnolo tu?"] },
        { "type": "choice", "prompt": "Julie kommt aus Paris. Wie sagt sie „Ich bin Französin“?",
          "options": ["Sono francesa.", "Sono francese.", "Sono franceso."],
          "answer": 1, "explain": "Adjektive auf -e sind für Männer und Frauen gleich: francese." }
      ]
    },
    {
      "id": "verbi-are",
      "title": "Regelmäßige Verben auf -are: parlare",
      "blocks": [
        { "type": "p", "text": "Die meisten italienischen Verben enden auf -are – und die meisten davon sind regelmäßig. Du nimmst -are weg und hängst die Endung an. So geht es mit parlare (sprechen):" },
        { "type": "table", "head": ["Person", "Endung", "parlare", "Deutsch"], "rows": [
          ["io", "-o", "parlo", "ich spreche"],
          ["tu", "-i", "parli", "du sprichst"],
          ["lui / lei / Lei", "-a", "parla", "er / sie spricht; Sie sprechen"],
          ["noi", "-iamo", "parliamo", "wir sprechen"],
          ["voi", "-ate", "parlate", "ihr sprecht"],
          ["loro", "-ano", "parlano", "sie sprechen"]
        ] },
        { "type": "p", "text": "Genauso funktionieren abitare (wohnen): abito, abiti, abita … und imparare (lernen): imparo, impari, impara …" },
        { "type": "tip", "text": "Wie bei essere lässt man das Pronomen meistens weg: Parlo italiano. = Ich spreche Italienisch. Verneint mit non: Non parlo francese." },
        { "type": "tip", "text": "Betonung: In der loro-Form liegt sie nicht auf der Endung – PAR-la-no, nicht par-LA-no. Bei abitare liegt sie in den Formen für io, tu, lui / lei und loro auf der ersten Silbe: A-bi-to, A-bi-ta-no." },
        { "type": "examples", "items": [
          { "text": "Parli tedesco?", "de": "Sprichst du Deutsch?" },
          { "text": "Sì, e parlo anche un po' di inglese.", "de": "Ja, und ich spreche auch ein bisschen Englisch." },
          { "text": "Dove abitate?", "de": "Wo wohnt ihr?" },
          { "text": "Paolo e Sara imparano il tedesco.", "de": "Paolo und Sara lernen Deutsch." }
        ] }
      ],
      "exercises": [
        { "type": "cloze", "text": "Io ___ tedesco e inglese.", "answers": ["parlo"], "de": "Ich spreche Deutsch und Englisch.", "hint": "parlare" },
        { "type": "cloze", "text": "Tu ___ francese?", "answers": ["parli"], "de": "Sprichst du Französisch?", "hint": "parlare" },
        { "type": "cloze", "text": "Signora, Lei ___ inglese?", "answers": ["parla"], "de": "Sprechen Sie Englisch?", "hint": "parlare" },
        { "type": "cloze", "text": "Giulia ___ a Roma.", "answers": ["abita"], "de": "Giulia wohnt in Rom.", "hint": "abitare" },
