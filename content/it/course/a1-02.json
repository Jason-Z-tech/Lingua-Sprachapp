        { "type": "cloze", "text": "Marco e Luca ___ spagnolo.", "answers": ["parlano"], "de": "Marco und Luca sprechen Spanisch.", "hint": "parlare" },
        { "type": "order", "de": "Ich spreche ein bisschen Italienisch.", "answer": "Parlo un po' di italiano." },
        { "type": "translate", "de": "Ich spreche kein Französisch.", "answers": ["Non parlo francese.", "Io non parlo francese.", "Non parlo il francese.", "Io non parlo il francese."] }
      ]
    },
    {
      "id": "di-a-in",
      "title": "Woher? Wo? – di, a und in",
      "blocks": [
        { "type": "p", "text": "Nach der Herkunft fragst du mit di dove: Di dove sei? = Woher kommst du? (wörtlich: Von wo bist du?) Die Antwort: Sono di + Stadt." },
        { "type": "examples", "items": [
          { "text": "Di dove sei? – Sono di Monaco.", "de": "Woher kommst du? – Ich komme aus München." },
          { "text": "Di dov'è Lei? – Sono di Vienna.", "de": "Woher kommen Sie? – Ich komme aus Wien." },
          { "text": "Di dov'è Lukas? – È di Zurigo.", "de": "Woher kommt Lukas? – Er kommt aus Zürich." }
        ] },
        { "type": "p", "text": "Wo jemand wohnt, sagst du mit abitare. Vor Städten steht a, vor Ländern in:" },
        { "type": "table", "head": ["Ort", "Präposition", "Beispiel", "Deutsch"], "rows": [
          ["Stadt (Herkunft)", "di", "Sono di Amburgo.", "Ich komme aus Hamburg."],
          ["Stadt (Wohnort)", "a", "Abito a Berlino.", "Ich wohne in Berlin."],
          ["Land", "in", "Abito in Germania.", "Ich wohne in Deutschland."]
        ] },
        { "type": "tip", "text": "Länder haben normalerweise einen Artikel (la Germania, l'Italia). Nach in fällt er weg: in Germania, in Italia, in Svizzera." },
        { "type": "tip", "text": "Auch richtig: Vengo da Monaco. = Ich komme aus München. Das Verb venire (kommen) lernst du später." },
        { "type": "p", "text": "Viele Städte haben auf Italienisch eigene Namen:" },
        { "type": "list", "items": [
          "Monaco (di Baviera) = München – Monaco allein kann auch das Fürstentum Monaco sein",
          "Vienna = Wien",
          "Amburgo = Hamburg",
          "Colonia = Köln",
          "Zurigo = Zürich",
          "Ginevra = Genf",
          "Milano = Mailand",
          "Firenze = Florenz",
          "Venezia = Venedig",
          "Napoli = Neapel"
        ] }
      ],
      "exercises": [
