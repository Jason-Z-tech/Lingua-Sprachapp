  "dialogue": {
    "title": "Piacere!",
    "title_de": "Freut mich!",
    "lines": [
      { "speaker": "Giulia", "text": "Ciao! Io sono Giulia. E tu, come ti chiami?", "de": "Hallo! Ich bin Giulia. Und du, wie heißt du?" },
      { "speaker": "Marco", "text": "Ciao, Giulia! Mi chiamo Marco. Piacere!", "de": "Hallo, Giulia! Ich heiße Marco. Freut mich!" },
      { "speaker": "Giulia", "text": "Piacere! Lui è Luca. È un amico.", "de": "Freut mich! Das ist Luca. Er ist ein Freund." },
      { "speaker": "Luca", "text": "Ciao, Marco! Come stai?", "de": "Hallo, Marco! Wie geht's dir?" },
      { "speaker": "Marco", "text": "Bene, grazie. E tu?", "de": "Gut, danke. Und dir?" },
      { "speaker": "Luca", "text": "Così così. Oh, buongiorno, signora Bianchi!", "de": "So lala. Oh, guten Morgen, Frau Bianchi!" },
      { "speaker": "Signora Bianchi", "text": "Buongiorno, Luca! Come stai?", "de": "Guten Morgen, Luca! Wie geht's dir?" },
      { "speaker": "Luca", "text": "Bene, grazie. E Lei, signora, come sta?", "de": "Gut, danke. Und wie geht es Ihnen?" },
      { "speaker": "Signora Bianchi", "text": "Molto bene, grazie. E lui come si chiama?", "de": "Sehr gut, danke. Und wie heißt er?" },
      { "speaker": "Marco", "text": "Mi chiamo Marco. Piacere, signora.", "de": "Ich heiße Marco. Freut mich." },
      { "speaker": "Signora Bianchi", "text": "Piacere, Marco. Arrivederci!", "de": "Freut mich, Marco. Auf Wiedersehen!" },
      { "speaker": "Giulia", "text": "Arrivederci, signora! Ciao, Luca, a domani!", "de": "Auf Wiedersehen! Tschüss, Luca, bis morgen!" }
    ]
  },
