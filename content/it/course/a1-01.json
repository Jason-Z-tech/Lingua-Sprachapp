  "grammar": [
    {
      "id": "essere",
      "title": "Das Verb essere (sein)",
      "blocks": [
        { "type": "p", "text": "Essere bedeutet „sein“. Wie im Deutschen ist das Verb unregelmäßig – die Formen lernst du am besten auswendig." },
        { "type": "table", "head": ["Person", "essere", "Deutsch"], "rows": [
          ["io", "sono", "ich bin"],
          ["tu", "sei", "du bist"],
          ["lui / lei / Lei", "è", "er / sie ist; Sie sind"],
          ["noi", "siamo", "wir sind"],
          ["voi", "siete", "ihr seid"],
          ["loro", "sono", "sie sind"]
        ] },
        { "type": "tip", "text": "Die Pronomen lässt man meistens weg, weil die Verbform schon zeigt, wer gemeint ist: Sono Marco. = Ich bin Marco. Sono heißt „ich bin“ und „sie sind“ – was gemeint ist, verrät der Zusammenhang." },
        { "type": "tip", "text": "Lei (großgeschrieben) ist die höfliche Anrede „Sie“. Das Verb steht dann in der 3. Person Einzahl: Lei è il signor Rossi? = Sind Sie Herr Rossi?" },
        { "type": "p", "text": "Verneinen ist einfach: Du stellst non vor das Verb. Non sono Anna. = Ich bin nicht Anna. Eine Frage bildest du ohne Umstellung – nur die Stimme geht am Ende nach oben: Sei Marco? = Bist du Marco?" },
        { "type": "examples", "items": [
          { "text": "Sono Giulia.", "de": "Ich bin Giulia." },
          { "text": "Sei Luca?", "de": "Bist du Luca?" },
          { "text": "Siamo amici.", "de": "Wir sind Freunde." },
          { "text": "Lei è la signora Bianchi?", "de": "Sind Sie Frau Bianchi?" },
          { "text": "No, non sono Paolo.", "de": "Nein, ich bin nicht Paolo." }
        ] }
      ],
