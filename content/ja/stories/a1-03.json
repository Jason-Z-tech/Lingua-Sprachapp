  "title": "私[わたし] の かぞく",
  "title_de": "Meine Familie",
  "topics": ["alltag"],
  "summary_de": "Die 16-jährige Yui stellt ihre Eltern, ihren großen Bruder, ihre kleine Schwester und die Katze Momo vor.",
  "sentences": [
    { "text": "私[わたし] は ゆい です。", "de": "Ich bin Yui." },
    { "text": "十六[じゅうろく]さい です。 高校生[こうこうせい] です。", "de": "Ich bin 16 Jahre alt und gehe auf die Oberschule." },
    { "text": "私[わたし] の かぞく は 五人[ごにん] です。", "de": "Wir sind zu fünft in der Familie." },
    { "text": "父[ちち] と 母[はは] と あに と いもうと と 私[わたし] です。", "de": "Mein Vater, meine Mutter, mein großer Bruder, meine kleine Schwester und ich." },
    { "text": "父[ちち] は 四十八[よんじゅうはっ]さい です。", "de": "Mein Vater ist 48 Jahre alt.", "break": true },
    { "text": "会社員[かいしゃいん] です。", "de": "Er ist Angestellter." },
    { "text": "毎日[まいにち] 電車[でんしゃ] で 会社[かいしゃ] に 行[い]き ます。", "de": "Jeden Tag fährt er mit dem Zug in die Firma." },
    { "text": "母[はは] は 四十五[よんじゅうご]さい です。", "de": "Meine Mutter ist 45." },
    { "text": "小学校[しょうがっこう] の 先生[せんせい] です。", "de": "Sie ist Grundschullehrerin." },
    { "text": "母[はは] は りょうり が とても 上手[じょうず] です。", "de": "Meine Mutter kocht sehr gut." },
    { "text": "あに は 十九[じゅうきゅう]さい です。", "de": "Mein großer Bruder ist 19.", "break": true },
    { "text": "大学生[だいがくせい] です。 サッカー が 大[だい]すき です。", "de": "Er studiert und liebt Fußball." },
    { "text": "いもうと は 十二[じゅうに]さい です。", "de": "Meine kleine Schwester ist 12." },
    { "text": "とても 元気[げんき] です。 よく うた を うたい ます。", "de": "Sie ist sehr lebhaft und singt oft." },
    { "text": "それから、 ねこ も い ます。", "de": "Außerdem haben wir auch eine Katze.", "break": true },
    { "text": "名前[なまえ] は モモ です。 三[さん]さい です。", "de": "Sie heißt Momo und ist drei Jahre alt." },
    { "text": "モモ は 白[しろ]い ねこ です。", "de": "Momo ist eine weiße Katze." },
    { "text": "毎日[まいにち] たくさん ね ます。", "de": "Sie schläft jeden Tag sehr viel." },
    { "text": "私[わたし] は かぞく と モモ が 大[だい]すき です。", "de": "Ich habe meine Familie und Momo sehr lieb." }
  ],
