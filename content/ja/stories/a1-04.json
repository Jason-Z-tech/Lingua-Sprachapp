  "title": "ぼく の しゅうまつ",
  "title_de": "Mein Wochenende",
  "topics": ["sport"],
  "summary_de": "Der Student Ken verbringt sein Wochenende mit Joggen im Park, Fußball mit Freunden und Schwimmen im Hallenbad.",
  "sentences": [
    { "text": "ぼく は けん です。 大学生[だいがくせい] です。", "de": "Ich bin Ken und studiere an der Uni." },
    { "text": "ぼく は スポーツ が 大[だい]すき です。", "de": "Ich liebe Sport." },
    { "text": "どようび の 朝[あさ]、 ぼく は こうえん で はしり ます。", "de": "Am Samstagmorgen jogge ich im Park.", "break": true },
    { "text": "一時間[いちじかん] ぐらい はしり ます。", "de": "Ich laufe ungefähr eine Stunde." },
    { "text": "朝[あさ] の こうえん は しずか です。", "de": "Morgens ist der Park ruhig." },
    { "text": "空気[くうき] も きれい です。", "de": "Auch die Luft ist sauber." },
    { "text": "午後[ごご] は 友[とも]だち と サッカー を し ます。", "de": "Am Nachmittag spiele ich mit Freunden Fußball.", "break": true },
    { "text": "ぼくたち の チーム は つよい です。", "de": "Unsere Mannschaft ist stark." },
    { "text": "でも、 ぼく は あまり 上手[じょうず] じゃ ありません。", "de": "Aber ich selbst bin nicht besonders gut." },
    { "text": "サッカー の あと、 みんな で ラーメン を 食[た]べ ます。", "de": "Nach dem Fußball essen wir alle zusammen Ramen." },
    { "text": "にちようび は プール に 行[い]き ます。", "de": "Am Sonntag gehe ich ins Schwimmbad.", "break": true },
    { "text": "三十分[さんじゅっぷん] およぎ ます。", "de": "Ich schwimme dreißig Minuten." },
    { "text": "水[みず] は 少[すこ]し つめたい です。", "de": "Das Wasser ist ein bisschen kalt." },
    { "text": "でも、 とても 気[き]もち が いい です。", "de": "Aber es fühlt sich sehr gut an." },
    { "text": "よる は とても ねむい です。", "de": "Abends bin ich sehr müde.", "break": true },
    { "text": "ぼく の しゅうまつ は いそがしい です。", "de": "Mein Wochenende ist ziemlich voll." },
    { "text": "でも、 とても たのしい です！", "de": "Aber es macht großen Spaß!" }
  ],
