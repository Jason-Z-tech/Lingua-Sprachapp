  "title": "東京[とうきょう] の 小[ちい]さい カフェ",
  "title_de": "Ein kleines Café in Tokio",
  "topics": ["essen", "alltag"],
  "summary_de": "Lena aus Deutschland frühstückt jeden Morgen in einem kleinen Café in Tokio und bestellt beim freundlichen Herrn Yamada das Frühstücksset.",
  "sentences": [
    { "text": "私[わたし] は レナ です。", "de": "Ich bin Lena." },
    { "text": "ドイツ人[じん] の 学生[がくせい] です。", "de": "Ich bin Studentin aus Deutschland." },
    { "text": "今[いま]、 東京[とうきょう] に い ます。", "de": "Zurzeit bin ich in Tokio." },
    { "text": "大学[だいがく] で 日本語[にほんご] を べんきょう し ます。", "de": "An der Uni lerne ich Japanisch." },
    { "text": "毎朝[まいあさ]、 私[わたし] は 小[ちい]さい カフェ に 行[い]き ます。", "de": "Jeden Morgen gehe ich in ein kleines Café.", "break": true },
    { "text": "カフェ は 駅[えき] の 前[まえ] に あり ます。", "de": "Das Café ist vor dem Bahnhof." },
    { "text": "古[ふる]い カフェ です。", "de": "Es ist ein altes Café." },
    { "text": "でも、 とても きれい です。", "de": "Aber es ist sehr schön." },
    { "text": "カフェ の マスター は 山田[やまだ] さん です。", "de": "Der Wirt des Cafés ist Herr Yamada.", "break": true },
    { "text": "山田[やまだ] さん は とても やさしい です。", "de": "Herr Yamada ist sehr freundlich." },
    {
      "text": "「 おはようございます、 レナ さん」 と 山田[やまだ] さん が 言[い]い ます。",
      "de": "„Guten Morgen, Lena“, sagt Herr Yamada.",
      "gloss": { "と": { "lemma": "と", "de": "Zitatpartikel (steht nach wörtlicher Rede)", "pos": "particle" } }
    },
    {
      "text": "「 おはようございます。 モーニングセット を ください」 と 私[わたし] は 言[い]い ます。",
      "de": "„Guten Morgen. Das Frühstücksset, bitte“, sage ich.",
      "gloss": { "と": { "lemma": "と", "de": "Zitatpartikel (steht nach wörtlicher Rede)", "pos": "particle" } }
    },
    { "text": "モーニングセット は コーヒー と パン と たまご です。", "de": "Zum Frühstücksset gehören Kaffee, Toast und ein Ei.", "break": true },
    { "text": "ぜんぶ で 五百円[ごひゃくえん] です。", "de": "Zusammen kostet es 500 Yen." },
    { "text": "とても 安[やす]い です。", "de": "Das ist sehr günstig." },
    { "text": "コーヒー は 少[すこ]し にがい です。", "de": "Der Kaffee ist ein bisschen bitter." },
    { "text": "でも、 とても おいしい です。", "de": "Aber er schmeckt sehr gut." },
    { "text": "私[わたし] は カフェ で 日本語[にほんご] の 本[ほん] を 読[よ]み ます。", "de": "Im Café lese ich ein japanisches Buch." },
    { "text": "八時[はちじ] に 大学[だいがく] へ 行[い]き ます。", "de": "Um acht Uhr gehe ich zur Uni.", "break": true },
    { "text": "「 ごちそうさまでした。 また あした！」", "de": "„Danke, es war lecker. Bis morgen!“" },
    { "text": "「 いってらっしゃい、 レナ さん！」", "de": "„Bis später, Lena – einen schönen Tag!“" }
  ],
